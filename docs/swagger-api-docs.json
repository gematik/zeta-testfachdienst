          "patientId" : {
            "type" : "string",
            "description" : "FHIR/PKV patient identifier",
            "example" : "PAT-123456",
            "minLength" : 1
          },
          "practitionerId" : {
            "type" : "string",
            "description" : "Identifier of prescribing practitioner",
